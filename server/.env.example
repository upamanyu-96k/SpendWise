PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/spendwise
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Optional. Base URL for password-reset links (defaults to CLIENT_ORIGIN).
# APP_URL=https://your-live-site.onrender.com
# Optional. Without a key, reset links are printed in the server terminal (development only).
# RESEND_API_KEY=
# MAIL_FROM=SpendWise <onboarding@resend.dev>
